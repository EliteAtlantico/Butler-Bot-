<mujoco model="home_search">
  <!-- The end-to-end demo scene: explorable rooms AND pickable objects.

       apartment.xml plus a set of keys, for natural-language search ("find my
       keys"), plus scene_home.xml's pickable items so the same scene carries
       the command -> explore -> navigate -> pick pipeline to the end. Before
       this, no single scene had both: home_search.xml had rooms and nothing
       to grasp, scene_home.xml had objects and no rooms to explore.

       scene_home.xml's `person` body is deliberately NOT carried over -- it
       exists for hand-over, and this integration exposes Pick only.

       The keys lie on the sideboard in the living room: behind the divider,
       invisible from the start in room A, in a place people really leave
       keys. Room A offers plausible decoys (dining table, bookshelf) with
       little on them, so a search that only follows "where keys usually are"
       still has to look and move on.

       Below: the original apartment notes.

       A furnished two-room flat, built to be harder than a field of cylinders.

       What makes it a real test rather than a prettier one:
         * thin chair and table legs are only a few pixels wide at range, so
           they test the depth camera's resolution, not just its reach;
         * a table top at 0.74 m is an obstacle for a 1.66 m robot even though
           the floor under it is clear -- the 2-D grid gets that right here
           only because the top projects down onto the legs' footprint;
         * the doorway is the sole route between rooms, so the goal cannot be
           reached by drifting in roughly the right direction;
         * furniture occludes furniture, which is what the world-XY clustering
           in the detector was written for.

       Colours are furniture-plausible rather than saturated primaries, so the
       hue-window detector has no easy handle here: use --detector geometric. -->
  <include file="../main_mujoco/chopped_dynamic.xml"/>
  <!-- meshdir must stay pointed at the robot's meshes and must come after the
       include; the scene's own meshes are reached relative to it. texturedir
       is separate, so it can point straight at assets/. -->
  <compiler meshdir="../main_mujoco/meshes/" texturedir="assets/"/>
  <!-- the household items as they look: textured models, visual only -->
  <include file="assets/household.xml"/>
  <!-- From scene_home.xml, and load-bearing for grasping: MuJoCo's soft
       friction lets a squeezed item creep down through the fingers at about
       0.5 mm/s, which slides flat items out of the grip on any carry longer
       than ~30 s. Without this the pick half of the demo fails silently after
       the robot has already picked the object up. -->
  <option noslip_iterations="5"/>

  <statistic center="5 0 1.0" extent="7.0"/>

  <visual>
    <headlight diffuse="0.5 0.5 0.5" ambient="0.4 0.4 0.4" specular="0.05 0.05 0.05"/>
    <rgba haze="0.2 0.2 0.22 1"/>
    <global azimuth="150" elevation="-25" offwidth="1280" offheight="960"/>
    <map znear="0.01" zfar="50"/>
    <quality shadowsize="4096"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.62 0.68 0.76" rgb2="0.24 0.27 0.32" width="512" height="3072"/>

    <!-- Procedural textures and object meshes, all regenerated by
         tools/make_assets.py. The meshes are visual only (class "look":
         contype=0 conaffinity=0 mass=0) and every item body carries an
         explicit <inertial>, so collision shape, mass and inertia are
         byte-identical to the primitives-only version and the pick/chore
         baselines are untouched. Detailed meshes would collide as their
         convex hull in any case -- for a key that is a wedge, which would make
         grasping worse. The items' own meshes come from assets/household.xml. -->
    <texture type="2d" name="t_floor" file="floor_oak.png"/>
    <texture type="2d" name="t_wall"  file="wall_plaster.png"/>
    <texture type="2d" name="t_sofa"  file="sofa_weave.png"/>
    <texture type="2d" name="t_walnut" file="wood_walnut.png"/>
    <texture type="2d" name="t_oak"   file="wood_oak.png"/>
    <texture type="2d" name="t_metal" file="metal_brushed.png"/>

    <mesh name="m_foliage"   file="../../comp_vision_sim/assets/foliage.stl"/>
    <mesh name="m_pot"       file="../../comp_vision_sim/assets/pot.stl"/>

    <!-- texuniform on an infinite plane scales the texture by world distance,
         so texrepeat sets the board pitch: the sheet holds 7 boards, and 1.6
         repeats/m puts them at about 0.09 m each. Mapping the sheet a handful
         of times across the whole room instead stretches each board to half a
         metre and it reads as tiling, not timber. -->
    <material name="floorwood" texture="t_floor" texuniform="true" texrepeat="1.6 1.6"
              reflectance="0.05" specular="0.18" shininess="0.25"/>
    <material name="wall"    texture="t_wall" texuniform="true" texrepeat="4 3" specular="0.05"/>
    <material name="wood"    texture="t_oak" texuniform="true" texrepeat="2 2"
              specular="0.3" shininess="0.35"/>
    <material name="darkwood" texture="t_walnut" texuniform="true" texrepeat="2 2"
              specular="0.25" shininess="0.3"/>
    <material name="fabric"  texture="t_sofa" texuniform="true" texrepeat="3 3" specular="0.04"/>
    <material name="cushion" texture="t_sofa" texuniform="true" texrepeat="2 2"
              rgba="1.22 1.22 1.22 1" specular="0.04"/>
    <material name="metal"   texture="t_metal" texuniform="true" texrepeat="1 1"
              specular="0.75" shininess="0.72" reflectance="0.12"/>
    <material name="carton"  rgba="0.72 0.58 0.38 1" specular="0.05"/>
    <material name="plant"   rgba="0.22 0.42 0.20 1" specular="0.22" shininess="0.35"/>
    <material name="terracotta" rgba="0.68 0.38 0.26 1" specular="0.10"/>
    <material name="soil"    rgba="0.20 0.15 0.11 1" specular="0.02"/>
    <material name="white"   rgba="0.94 0.93 0.89 1" specular="0.15"/>
    <material name="skirting" rgba="0.93 0.92 0.89 1" specular="0.12" shininess="0.3"/>
    <material name="rug"rgba="0.44 0.26 0.22 1" specular="0.04"/>
    <material name="rug_field" rgba="0.66 0.50 0.38 1" specular="0.04"/>
    <material name="brass"   rgba="0.80 0.66 0.30 1" specular="0.6" shininess="0.6"/>
    <material name="steel"   rgba="0.75 0.76 0.78 1" specular="0.7" shininess="0.7"/>
    <material name="leather" rgba="0.55 0.12 0.10 1"/>
    <!-- pickable-item colours, carried over from scene_home.xml unchanged.
         They colour the collision primitives, which are not rendered; what
         the cameras see is each item's "look" geom. -->
    <material name="mug"    rgba="0.85 0.18 0.18 1"/>
    <material name="can"    rgba="0.15 0.70 0.25 1"/>
    <material name="bottle" rgba="0.92 0.80 0.10 1"/>
    <material name="remote" rgba="0.50 0.20 0.75 1"/>
    <material name="keys"   rgba="0.95 0.50 0.10 1"/>
    <material name="ball"   rgba="0.95 0.30 0.65 1"/>
    <material name="box"    rgba="0.10 0.65 0.70 1"/>
  </asset>

  <!-- Every pickable object is a free body whose name matches a class in
       Hand_and_Wrists/handwrist/objects.py, and whose graspable geom carries
       the name that class expects (mug_body, keys_body, ...). Items have
       higher contact priority than the finger pads so the pads' friction
       governs the grasp. Copied from scene_home.xml rather than re-authored:
       the grasp tuning and the committed pick_eval baselines depend on these
       exact sizes. -->
  <default>
    <default class="item">
      <geom condim="4" friction="1.0 0.01 0.001" solref="0.005 1" priority="1" group="3"/>
    </default>
    <!-- what the cameras see: no mass, no contacts, inside the primitives.
         Group 2, the robot model's visual group, which handwrist's geometry
         (footprints, surfaces, support rays) ignores. -->
    <default class="look">
      <geom type="mesh" contype="0" conaffinity="0" group="2" mass="0"/>
    </default>
  </default>

  <worldbody>
    <!-- Warm ceiling lights over each room, a cooler fill from the window wall,
         and one directional for shadow direction. Slightly warm diffuse is
         what makes an interior read as lit rather than rendered. -->
    <light pos="2.0 -1.0 2.35" dir="0 0 -1" directional="false" diffuse="0.42 0.39 0.34"
           attenuation="1 0.05 0.02" cutoff="70"/>
    <light pos="2.2  2.2 2.35" dir="0 0 -1" directional="false" diffuse="0.34 0.32 0.28"
           attenuation="1 0.05 0.02" cutoff="70"/>
    <light pos="8.6  1.6 2.35" dir="0 0 -1" directional="false" diffuse="0.42 0.39 0.34"
           attenuation="1 0.05 0.02" cutoff="70"/>
    <light pos="9.4 -2.4 2.35" dir="0 0 -1" directional="false" diffuse="0.34 0.32 0.28"
           attenuation="1 0.05 0.02" cutoff="70"/>
    <light pos="5 -6 3.2" dir="0 0.7 -0.7" directional="true" diffuse="0.26 0.28 0.32"/>
    <light pos="5 0 6" dir="0 0 -1" directional="true" diffuse="0.22 0.21 0.19"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="floorwood"
          friction="1.6 0.01 0.001" condim="4"/>

    <!-- A rug under the living-room table. Thin and flush, so it is scenery to
         the eye and nothing at all to the occupancy grid. -->
    <body name="rug" pos="8.5 0.6 0.004">
      <geom type="box" size="1.35 0.95 0.004" material="rug"
            contype="0" conaffinity="0"/>
      <geom type="box" pos="0 0 0.0005" size="1.22 0.84 0.004" material="rug_field"
            contype="0" conaffinity="0"/>
    </body>

    <!-- Skirting: visual only, and inset 0.01 m so it can never be the thing
         the planner's inflation catches on. -->
    <body name="trim" pos="0 0 0">
      <geom type="box" pos="-0.88 0 0.055" size="0.02 3.9 0.055" material="skirting" contype="0" conaffinity="0"/>
      <geom type="box" pos="10.88 0 0.055" size="0.02 3.9 0.055" material="skirting" contype="0" conaffinity="0"/>
      <geom type="box" pos="5 -3.88 0.055" size="5.88 0.02 0.055" material="skirting" contype="0" conaffinity="0"/>
      <geom type="box" pos="5  3.88 0.055" size="5.88 0.02 0.055" material="skirting" contype="0" conaffinity="0"/>
      <geom type="box" pos="4.88 -1.95 0.055" size="0.02 2.05 0.055" material="skirting" contype="0" conaffinity="0"/>
      <geom type="box" pos="5.12 -1.95 0.055" size="0.02 2.05 0.055" material="skirting" contype="0" conaffinity="0"/>
      <geom type="box" pos="4.88  2.95 0.055" size="0.02 1.05 0.055" material="skirting" contype="0" conaffinity="0"/>
      <geom type="box" pos="5.12  2.95 0.055" size="0.02 1.05 0.055" material="skirting" contype="0" conaffinity="0"/>
      <!-- door architrave around the opening -->
      <geom type="box" pos="5 0.10 0.95" size="0.13 0.03 0.95" material="skirting" contype="0" conaffinity="0"/>
      <geom type="box" pos="5 1.90 0.95" size="0.13 0.03 0.95" material="skirting" contype="0" conaffinity="0"/>
      <geom type="box" pos="5 1.00 1.92" size="0.13 0.93 0.03" material="skirting" contype="0" conaffinity="0"/>
    </body>

    <!-- ============ shell ============ -->
    <body name="wall_w" pos="-1.0 0 1.2"><geom type="box" size="0.1 4.0 1.2" material="wall"/></body>
    <body name="wall_e" pos="11.0 0 1.2"><geom type="box" size="0.1 4.0 1.2" material="wall"/></body>
    <body name="wall_s" pos="5.0 -4.0 1.2"><geom type="box" size="6.0 0.1 1.2" material="wall"/></body>
    <body name="wall_n" pos="5.0  4.0 1.2"><geom type="box" size="6.0 0.1 1.2" material="wall"/></body>

    <!-- Divider with a single doorway. The leaves stop at y 0.10 and y 1.90,
         so the opening is 1.80 m wide, and the lintel has to span all of it:
         at 0.70 half-length it covered only y 0.50..1.90 and left a 0.40 m
         slot open from the floor to the top of the wall. -->
    <body name="divider_s" pos="5.0 -1.95 1.2"><geom type="box" size="0.1 2.05 1.2" material="wall"/></body>
    <body name="divider_n" pos="5.0  2.95 1.2"><geom type="box" size="0.1 1.05 1.2" material="wall"/></body>
    <body name="door_lintel" pos="5.0 1.0 2.15"><geom type="box" size="0.1 0.9 0.25" material="wall"/></body>

    <!-- ============ room A: dining ============ -->
    <body name="table" pos="2.3 -1.6 0">
      <geom name="table_top" type="box" pos="0 0 0.73" size="0.80 0.45 0.03" material="wood"/>
      <geom type="box" pos=" 0.72 -0.37 0.36" size="0.04 0.04 0.36" material="darkwood"/>
      <geom type="box" pos="-0.72 -0.37 0.36" size="0.04 0.04 0.36" material="darkwood"/>
      <geom type="box" pos=" 0.72  0.37 0.36" size="0.04 0.04 0.36" material="darkwood"/>
      <geom type="box" pos="-0.72  0.37 0.36" size="0.04 0.04 0.36" material="darkwood"/>
    </body>

    <body name="chair_a" pos="1.4 -0.7 0">
      <geom type="box" pos="0 0 0.44" size="0.21 0.21 0.03" material="wood"/>
      <geom type="box" pos="0 -0.19 0.68" size="0.21 0.03 0.22" material="wood"/>
      <geom type="box" pos=" 0.17  0.17 0.22" size="0.022 0.022 0.22" material="darkwood"/>
      <geom type="box" pos="-0.17  0.17 0.22" size="0.022 0.022 0.22" material="darkwood"/>
      <geom type="box" pos=" 0.17 -0.17 0.22" size="0.022 0.022 0.22" material="darkwood"/>
      <geom type="box" pos="-0.17 -0.17 0.22" size="0.022 0.022 0.22" material="darkwood"/>
    </body>

    <body name="chair_b" pos="3.2 -2.5 0">
      <geom type="box" pos="0 0 0.44" size="0.21 0.21 0.03" material="wood"/>
      <geom type="box" pos="0 0.19 0.68" size="0.21 0.03 0.22" material="wood"/>
      <geom type="box" pos=" 0.17  0.17 0.22" size="0.022 0.022 0.22" material="darkwood"/>
      <geom type="box" pos="-0.17  0.17 0.22" size="0.022 0.022 0.22" material="darkwood"/>
      <geom type="box" pos=" 0.17 -0.17 0.22" size="0.022 0.022 0.22" material="darkwood"/>
      <geom type="box" pos="-0.17 -0.17 0.22" size="0.022 0.022 0.22" material="darkwood"/>
    </body>

    <!-- bookshelf against the west wall -->
    <body name="bookshelf" pos="-0.55 1.8 0">
      <geom type="box" pos="0 0 0.95" size="0.18 0.9 0.95" material="darkwood"/>
      <geom type="box" pos="0.02 0 1.25" size="0.16 0.85 0.03" material="wood"/>
      <geom type="box" pos="0.02 0 0.62" size="0.16 0.85 0.03" material="wood"/>
    </body>

    <!-- stacked cartons -->
    <body name="cartons" pos="1.1 2.7 0">
      <geom type="box" pos="0 0 0.25" size="0.28 0.28 0.25" material="carton"/>
      <geom type="box" pos="0.05 0.03 0.68" size="0.22 0.22 0.18" material="carton"/>
    </body>

    <!-- A potted plant: thin trunk, wide head -- still the classic depth-camera
         nuisance it was built to be. The collision shapes are the original
         cylinders and sphere, untouched, so it presents the planner exactly
         the same obstacle; the terracotta pot and the lumpy canopy are visual
         only and sit over the top of them. -->
    <body name="plant" pos="3.6 2.4 0">
      <geom type="cylinder" pos="0 0 0.16" size="0.18 0.16" material="carton" group="3"/>
      <geom type="cylinder" pos="0 0 0.55" size="0.035 0.28" material="darkwood" group="3"/>
      <geom type="sphere"   pos="0 0 0.95" size="0.34" material="plant" group="3"/>
      <geom type="mesh" mesh="m_pot" pos="0 0 0" material="terracotta"
            contype="0" conaffinity="0" group="0"/>
      <geom type="cylinder" pos="0 0 0.281" size="0.132 0.006" material="soil"
            contype="0" conaffinity="0" group="0"/>
      <geom type="cylinder" pos="0 0 0.50" size="0.024 0.22" material="darkwood"
            contype="0" conaffinity="0" group="0"/>
      <geom type="mesh" mesh="m_foliage" pos="0 0 0.95" material="plant"
            contype="0" conaffinity="0" group="0"/>
    </body>

    <!-- ============ room B: living ============ -->
    <body name="sofa" pos="8.6 2.2 0">
      <geom type="box" pos="0 0 0.20" size="1.05 0.42 0.20" material="fabric"/>
      <geom type="box" pos="0 0.33 0.48" size="1.05 0.09 0.28" material="fabric"/>
      <geom type="box" pos=" 0.96 0 0.42" size="0.09 0.42 0.22" material="cushion"/>
      <geom type="box" pos="-0.96 0 0.42" size="0.09 0.42 0.22" material="cushion"/>
    </body>

    <body name="coffee_table" pos="8.4 0.4 0">
      <geom type="box" pos="0 0 0.38" size="0.55 0.32 0.03" material="wood"/>
      <geom type="cylinder" pos=" 0.45 0.22 0.19" size="0.035 0.19" material="metal"/>
      <geom type="cylinder" pos="-0.45 0.22 0.19" size="0.035 0.19" material="metal"/>
      <geom type="cylinder" pos=" 0.45 -0.22 0.19" size="0.035 0.19" material="metal"/>
      <geom type="cylinder" pos="-0.45 -0.22 0.19" size="0.035 0.19" material="metal"/>
    </body>

    <!-- floor lamp: very thin pole, the hardest thing here to see -->
    <body name="lamp" pos="10.1 3.2 0">
      <geom type="cylinder" pos="0 0 0.02" size="0.22 0.02" material="metal"/>
      <geom type="cylinder" pos="0 0 0.75" size="0.022 0.75" material="metal"/>
      <geom type="cylinder" pos="0 0 1.62" size="0.20 0.16" material="white"/>
    </body>

    <body name="bin" pos="6.3 -3.1 0">
      <geom type="cylinder" pos="0 0 0.22" size="0.19 0.22" material="metal"/>
    </body>

    <!-- A low console, 0.55 m. Measured, not chosen for looks: the arm plans a
         grasp from a 0.55 m surface and none at all from 0.60 m or above, so a
         realistic 0.84 m sideboard would put the keys permanently out of
         reach and the fetch half of the demo could never finish. -->
    <body name="sideboard" pos="9.6 -3.3 0">
      <geom type="box" pos="0 0 0.275" size="0.85 0.24 0.275" material="darkwood"/>
      <geom type="box" pos="0 -0.26 0.40" size="0.30 0.02 0.12" material="wood"/>
    </body>
    <!-- ============ pickable items ============
         The search target stays where it was: on the living-room sideboard
         (top z 0.84), behind the divider and out of sight from the start.
         The geometry is scene_home.xml's pickable keys rather than the
         decorative set that stood here before -- handwrist's CATALOGUE grasps
         the geom named `keys_body`, and the decorative version had no such
         geom and no freejoint, so the arm could never have picked it up. -->
    <body name="keys" pos="9.35 -3.16 0.552" euler="0 0 0.5">
      <freejoint name="keys_free"/>
      <inertial pos="0.00714286 0 0.0108571" quat="0 0.734496 0 0.678613" mass="0.07"
                diaginertia="5.38052e-05 4.9973e-05 1.02528e-05"/>
      <!-- collision + what the gripper closes on: unchanged primitives -->
      <geom name="keys_body" class="item" type="box" pos="0 0 0.012" size="0.035 0.018 0.012"
            material="keys" mass="0.06" group="3"/>
      <geom name="keys_ring" class="item" type="cylinder" pos="0.05 0 0.004" size="0.015 0.004"
            material="keys" mass="0.01" group="3"/>
      <!-- what you see: a car-key fob, a brass and a nickel key on a split ring -->
      <geom class="look" mesh="look_keys_metal" material="look_keys_metal"/>
      <geom class="look" mesh="look_keys_fob" material="look_keys_fob"/>
    </body>

    <!-- On the living-room coffee table (top z 0.41), all within 0.10 m of its
         near edge at x 7.85. Measured: the planner finds 4 grasps at a 0.10 m
         inset and none at 0.20 m, because the base has to stop at the table
         and the arm reaches the rest of the way. Items placed centrally on a
         1.1 m-deep table look tidier and cannot be picked up. -->
    <body name="mug" pos="7.94 0.20 0.41">
      <freejoint name="mug_free"/>
      <inertial pos="0 0.006 0.05" quat="1 0 0 0" mass="0.25"
                diaginertia="0.000347773 0.000280973 0.00024408"/>
      <geom name="mug_body" class="item" type="cylinder" pos="0 0 0.05" size="0.04 0.05"
            material="mug" mass="0.22" group="3"/>
      <geom name="mug_handle" class="item" type="box" pos="0 0.05 0.05" size="0.008 0.012 0.03"
            material="mug" mass="0.03" group="3"/>
      <geom class="look" mesh="look_mug" material="look_mug"/>
    </body>
    <body name="can" pos="7.94 0.42 0.41">
      <freejoint name="can_free"/>
      <inertial pos="0 0 0.06" quat="1 0 0 0" mass="0.15"
                diaginertia="0.000220837 0.000220837 8.1675e-05"/>
      <geom name="can_body" class="item" type="cylinder" pos="0 0 0.06" size="0.033 0.06"
            material="can" mass="0.15" group="3"/>
      <geom class="look" mesh="look_can" material="look_can"/>
    </body>
    <body name="remote" pos="7.93 0.62 0.41" euler="0 0 0.6">
      <freejoint name="remote_free"/>
      <inertial pos="0 0 0.0125" quat="1 0 0 0" mass="0.12"
                diaginertia="2.929e-05 0.00033025 0.00034704"/>
      <geom name="remote_body" class="item" type="box" pos="0 0 0.0125" size="0.09 0.024 0.0125"
            material="remote" mass="0.12" group="3"/>
      <geom class="look" mesh="look_remote" material="look_remote"/>
    </body>

    <!-- The bottle stands on the floor beside the dining table rather than on
         it: that table's top is 0.76 m and nothing is pickable above 0.55 m. -->
    <body name="bottle" pos="1.35 -1.60 0">
      <freejoint name="bottle_free"/>
      <inertial pos="0 0 0.1" quat="1 0 0 0" mass="0.22"
                diaginertia="0.000825197 0.000825197 0.00012506"/>
      <geom name="bottle_body" class="item" type="cylinder" pos="0 0 0.09" size="0.035 0.09"
            material="bottle" mass="0.20" group="3"/>
      <geom name="bottle_neck" class="item" type="cylinder" pos="0 0 0.20" size="0.016 0.02"
            material="bottle" mass="0.02" group="3"/>
      <geom class="look" mesh="look_bottle" material="look_bottle"/>
    </body>

    <!-- on the floor, clear of the doorway corridor and both rooms' traffic.
         Both sit below the 0.10 m obstacle floor, so neither enters the
         occupancy grid as an obstacle. -->
    <body name="ball" pos="0.50 3.20 0">
      <freejoint name="ball_free"/>
      <geom name="ball_body" class="item" type="sphere" pos="0 0 0.035" size="0.035"
            material="ball" mass="0.06" condim="6" friction="1.0 0.02 0.002"/>
      <geom class="look" mesh="look_ball" material="look_ball"/>
    </body>
    <body name="box" pos="0.80 -3.20 0" euler="0 0 0.3">
      <freejoint name="box_free"/>
      <geom name="box_body" class="item" type="box" pos="0 0 0.025" size="0.06 0.025 0.025"
            material="box" mass="0.10"/>
      <geom class="look" mesh="look_box" material="look_box"/>
