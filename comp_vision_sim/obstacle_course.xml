<mujoco model="bracketbot obstacle course">
  <!-- Robot model lives in the sibling folder. Its own meshdir is relative to
       this file once included, which would point at comp_vision_sim/meshes,
       so it has to be redirected. The override MUST come after the include:
       the last <compiler> parsed wins, and putting it first silently loses to
       the included one. -->
  <include file="../main_mujoco/chopped_dynamic.xml"/>
  <compiler meshdir="../main_mujoco/meshes/"/>

  <statistic center="0 0 0.6" extent="2.0"/>

  <visual>
    <headlight diffuse="0.55 0.55 0.55" ambient="0.35 0.35 0.35" specular="0.1 0.1 0.1"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="140" elevation="-20" offwidth="1280" offheight="960"/>
    <map znear="0.01" zfar="40"/>
    <quality shadowsize="4096"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
             markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="8 8" reflectance="0.1"/>
    <!-- Detection classes are separated by hue, so keep these well apart on the
         colour wheel and away from the blue-grey floor and sky. -->
    <material name="target" rgba="0.85 0.15 0.12 1"/>
    <material name="pillar" rgba="0.20 0.45 0.85 1"/>
    <material name="barrier" rgba="0.85 0.55 0.10 1"/>
  </asset>

  <worldbody>
    <light pos="0 0 4" dir="0 0 -1" directional="true" diffuse="0.5 0.5 0.5"/>
    <light pos="3 3 3" dir="-1 -1 -1" directional="false" diffuse="0.4 0.4 0.4"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"
          friction="1.6 0.01 0.001" condim="4"/>

    <!-- Low barrier wall across the direct route, with a gap at y ~ 1.9.
         It is only 0.45 m tall: the head camera sits at 1.54 m, so the robot
         can see the target over the top while the ground path stays blocked.
         That is the whole point of the scene -- detection succeeds early,
         but a straight line to the goal does not exist. -->
    <body name="barrier_south" pos="3.0 -1.35 0.225">
      <geom type="box" size="0.12 2.65 0.225" material="barrier"/>
    </body>
    <body name="barrier_north" pos="3.0 3.85 0.225">
      <geom type="box" size="0.12 1.15 0.225" material="barrier"/>
    </body>

    <!-- Free-standing pillars: full height, so they block sight as well as travel -->
    <body name="pillar_a" pos="1.5 -1.3 0.5">
      <geom type="cylinder" size="0.16 0.5" material="pillar"/>
    </body>
    <body name="pillar_b" pos="4.7 3.1 0.4">
      <geom type="box" size="0.2 0.2 0.4" material="pillar"/>
    </body>
    <body name="pillar_c" pos="5.2 -2.6 0.45">
      <geom type="cylinder" size="0.22 0.45" material="pillar"/>
    </body>

    <!-- The goal: a tall red column, visible over the barrier from the start -->
    <body name="target_column" pos="6.0 0.0 0.6">
      <geom type="cylinder" size="0.18 0.6" material="target"/>
    </body>
  </worldbody>
</mujoco>
