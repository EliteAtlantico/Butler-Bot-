<mujoco model="bracketbot search course">
  <!-- A search problem, not a detection problem: unlike obstacle_course.xml,
       the target cannot be seen from the start. A full-height wall splits the
       space and the only way through is a 1.2 m doorway, so the robot has to
       decide where to look before it can find anything. Materials match the
       obstacle course so the trained YOLO net sees the same object classes. -->
  <include file="../main_mujoco/chopped_dynamic.xml"/>
  <compiler meshdir="../main_mujoco/meshes/"/>

  <statistic center="3.5 0 0.6" extent="6.0"/>

  <visual>
    <headlight diffuse="0.55 0.55 0.55" ambient="0.35 0.35 0.35" specular="0.1 0.1 0.1"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="140" elevation="-35" offwidth="1280" offheight="960"/>
    <map znear="0.01" zfar="40"/>
    <quality shadowsize="4096"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
             markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="8 8" reflectance="0.1"/>
    <material name="target" rgba="0.85 0.15 0.12 1"/>
    <material name="pillar" rgba="0.20 0.45 0.85 1"/>
    <material name="barrier" rgba="0.85 0.55 0.10 1"/>
    <!-- Walls are a neutral light grey: well away from the target's red, the
         pillars' blue and the barriers' orange, so they read as none of them. -->
    <material name="wall" rgba="0.74 0.74 0.72 1"/>
  </asset>

  <worldbody>
    <light pos="3.5 0 5" dir="0 0 -1" directional="true" diffuse="0.5 0.5 0.5"/>
    <light pos="0 3 3" dir="1 -1 -1" directional="false" diffuse="0.35 0.35 0.35"/>
    <light pos="7 -3 3" dir="-1 1 -1" directional="false" diffuse="0.35 0.35 0.35"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"
          friction="1.6 0.01 0.001" condim="4"/>

    <!-- Outer walls, 2 m tall: higher than the head camera, so they bound
         sight as well as travel. -->
    <body name="wall_south" pos="3.5 -5.5 1.0"><geom type="box" size="6.1 0.1 1.0" material="wall"/></body>
    <body name="wall_north" pos="3.5 5.5 1.0"><geom type="box" size="6.1 0.1 1.0" material="wall"/></body>
    <body name="wall_west" pos="-2.5 0 1.0"><geom type="box" size="0.1 5.5 1.0" material="wall"/></body>
    <body name="wall_east" pos="9.5 0 1.0"><geom type="box" size="0.1 5.5 1.0" material="wall"/></body>

    <!-- The dividing wall at x = 3.0, with a doorway from y = 1.4 to y = 2.6. -->
    <body name="divider_south" pos="3.0 -2.05 1.0"><geom type="box" size="0.1 3.45 1.0" material="wall"/></body>
    <body name="divider_north" pos="3.0 4.05 1.0"><geom type="box" size="0.1 1.45 1.0" material="wall"/></body>

    <!-- Start room -->
    <body name="pillar_a" pos="1.2 -2.2 0.5"><geom type="cylinder" size="0.16 0.5" material="pillar"/></body>
    <body name="barrier_start" pos="1.0 3.9 0.225"><geom type="box" size="0.7 0.12 0.225" material="barrier"/></body>

    <!-- Far room -->
    <body name="barrier_far" pos="5.5 -0.5 0.225"><geom type="box" size="0.12 1.0 0.225" material="barrier"/></body>
    <body name="pillar_b" pos="5.2 3.2 0.4"><geom type="box" size="0.2 0.2 0.4" material="pillar"/></body>
    <body name="pillar_c" pos="7.6 1.2 0.45"><geom type="cylinder" size="0.22 0.45" material="pillar"/></body>

    <!-- The target: behind the dividing wall, out of sight from the start. -->
    <body name="target_column" pos="6.5 -2.5 0.6">
      <geom type="cylinder" size="0.18 0.6" material="target"/>
    </body>
  </worldbody>
</mujoco>
