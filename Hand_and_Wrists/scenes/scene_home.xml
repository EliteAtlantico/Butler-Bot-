<mujoco model="bracketbot home">
  <include file="../../main_mujoco/chopped_dynamic.xml"/>
  <!-- chopped_dynamic.xml sets meshdir relative to main_mujoco; point it back
       there from this folder. Must come after the include to take effect. -->
  <compiler meshdir="../../main_mujoco/meshes/" texturedir="../../comp_vision_sim/assets/"/>
  <!-- What the items, the furniture and the person look like: textured
       models from comp_vision_sim/tools/make_assets.py, so a detector knows
       a mug by its shape and glaze rather than by a calibrated colour. They
       are visual only (class "look" below); the collision primitives are
       unchanged and hidden in group 3. -->
  <include file="../../comp_vision_sim/assets/household.xml"/>
  <!-- MuJoCo's soft friction lets a squeezed item creep down through the
       fingers at ~0.5 mm/s (6.6 mm in 12 s for the keys), which slid flat
       items out of the grip on any carry longer than ~30 s. The noslip pass
       removes the creep (0.0 mm in 12 s); balancing and driving unchanged. -->
  <option noslip_iterations="5"/>

  <statistic center="0.8 0 0.5" extent="2.6"/>

  <visual>
    <headlight diffuse="0.55 0.55 0.55" ambient="0.35 0.35 0.35" specular="0.1 0.1 0.1"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="150" elevation="-20" offwidth="1280" offheight="960"/>
    <map znear="0.005" zfar="30"/>
    <quality shadowsize="4096"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <!-- oak boards, as in home_search.xml, rather than a checkerboard -->
    <texture type="2d" name="woodfloor" file="floor_oak.png"/>
    <material name="woodfloor" texture="woodfloor" texuniform="true" texrepeat="1.6 1.6"
              reflectance="0.05" specular="0.18" shininess="0.25"/>
    <material name="furniture" rgba="0.42 0.30 0.22 1"/>
    <material name="basket" rgba="0.75 0.68 0.52 1"/>
    <material name="clothes" rgba="0.38 0.42 0.50 1"/>
    <material name="skin" rgba="0.80 0.66 0.56 1"/>
    <material name="mug" rgba="0.85 0.18 0.18 1"/>
    <material name="can" rgba="0.15 0.70 0.25 1"/>
    <material name="bottle" rgba="0.92 0.80 0.10 1"/>
    <material name="remote" rgba="0.50 0.20 0.75 1"/>
    <material name="keys" rgba="0.95 0.50 0.10 1"/>
    <material name="ball" rgba="0.95 0.30 0.65 1"/>
    <material name="box" rgba="0.10 0.65 0.70 1"/>
  </asset>

  <!-- Household objects. Every pickable object is a free body whose name
       matches a class in Hand_and_Wrists/handwrist/objects.py. Sizes are read
       back out of the compiled model, so changing a geom here is enough.
       Objects have lower contact priority than the finger pads, so the pads'
       friction governs the grasp.

       Each item's primitives are its physics and are not rendered (group 3);
       the "look" geom on the same body is what cameras see. It has no mass and
       no contacts, and fits inside the primitives' bounding box. Groups as in
       the robot's own model: visuals 2, collision 3 -- and handwrist's
       geometry (footprints, surfaces, support rays) ignores group-2 visuals. -->
  <default>
    <default class="item">
      <geom condim="4" friction="1.0 0.01 0.001" solref="0.005 1" priority="1" group="3"/>
    </default>
    <default class="look">
      <geom type="mesh" contype="0" conaffinity="0" group="2" mass="0"/>
    </default>
  </default>

  <worldbody>
    <light pos="1 0 4" dir="0 0 -1" directional="true" diffuse="0.5 0.5 0.5"/>
    <light pos="3 3 3" dir="-1 -1 -1" diffuse="0.35 0.35 0.35"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="woodfloor"
          friction="1.6 0.01 0.001" condim="4"/>

    <!-- coffee table, 0.40 m high, in front of the robot's start pose -->
    <body name="coffee_table" pos="1.25 0 0">
      <geom name="coffee_table_top" type="box" pos="0 0 0.385" size="0.30 0.45 0.015"
            material="look_tabletop" friction="1.0 0.01 0.001" condim="4"/>
      <geom type="box" pos=" 0.26  0.41 0.185" size="0.025 0.025 0.185" material="look_tableleg"/>
      <geom type="box" pos=" 0.26 -0.41 0.185" size="0.025 0.025 0.185" material="look_tableleg"/>
      <geom type="box" pos="-0.26  0.41 0.185" size="0.025 0.025 0.185" material="look_tableleg"/>
      <geom type="box" pos="-0.26 -0.41 0.185" size="0.025 0.025 0.185" material="look_tableleg"/>
    </body>

    <!-- side table, 0.60 m high, to the robot's left -->
    <body name="side_table" pos="0 1.4 0">
      <geom name="side_table_top" type="box" pos="0 0 0.585" size="0.22 0.22 0.015"
            material="look_tabletop" friction="1.0 0.01 0.001" condim="4"/>
      <geom type="box" pos="0 0 0.285" size="0.03 0.03 0.285" material="look_tableleg"/>
      <geom type="box" pos="0 0 0.01" size="0.18 0.18 0.01" material="look_tableleg"/>
    </body>

    <!-- laundry basket on the floor, to the robot's right: the drop-off.
         Woven wicker, with a rolled rim and a hand-hold in each end. The rim
         and hand-holds are visual only, inside the walls' footprint and no
         higher than their tops, so the place planner's rim height and
         footprint for the basket are unchanged. -->
    <body name="basket" pos="0.2 -1.3 0">
      <geom name="basket_floor" type="box" pos="0 0 0.005" size="0.2 0.15 0.005" material="look_wicker"/>
      <geom name="basket_wall_e" type="box" pos=" 0.195 0 0.09" size="0.005 0.15 0.09" material="look_wicker"/>
      <geom name="basket_wall_w" type="box" pos="-0.195 0 0.09" size="0.005 0.15 0.09" material="look_wicker"/>
      <geom name="basket_wall_n" type="box" pos="0  0.145 0.09" size="0.2 0.005 0.09" material="look_wicker"/>
      <geom name="basket_wall_s" type="box" pos="0 -0.145 0.09" size="0.2 0.005 0.09" material="look_wicker"/>
      <geom class="look" type="box" pos=" 0.192 0 0.174" size="0.008 0.150 0.006" material="look_tabletop"/>
      <geom class="look" type="box" pos="-0.192 0 0.174" size="0.008 0.150 0.006" material="look_tabletop"/>
      <geom class="look" type="box" pos="0  0.142 0.174" size="0.200 0.008 0.006" material="look_tabletop"/>
      <geom class="look" type="box" pos="0 -0.142 0.174" size="0.200 0.008 0.006" material="look_tabletop"/>
      <geom class="look" type="box" pos=" 0.1996 0 0.145" size="0.0005 0.045 0.012" rgba="0.08 0.06 0.04 1"/>
      <geom class="look" type="box" pos="-0.1996 0 0.145" size="0.0005 0.045 0.012" rgba="0.08 0.06 0.04 1"/>
    </body>

    <!-- a person standing in the living room with an open hand held out
         (toward -y), for hand-overs. The primitives are the collision shape
         and stay exactly as they were; what the cameras see is a clothed
         figure with a face, the palm of its hand on the palm box. -->
    <body name="person" pos="-1.0 1.75 0">
      <geom type="box" pos="0 0 0.42" size="0.13 0.09 0.42" material="clothes" group="3"/>
      <geom type="cylinder" pos="0 0 1.1" size="0.17 0.28" material="clothes" group="3"/>
      <geom type="sphere" pos="0 0 1.52" size="0.11" material="skin" group="3"/>
      <!-- hand held out at waist height: 0.63 m keeps the release point and
           the hover above it inside the arm's top-grasp envelope -->
      <!-- forearm kept BELOW the palm's top: level with it, an item set on
           the palm's edge landed on the arm instead -->
      <geom type="box" pos="0 -0.19 0.585" size="0.035 0.19 0.03" material="skin" group="3"/>
      <geom name="person_palm" type="box" pos="0 -0.43 0.615" size="0.07 0.06 0.012"
            material="skin" friction="1.2 0.01 0.001" condim="4" group="3"/>
      <geom class="look" mesh="look_person" material="look_person"/>
    </body>

    <!-- ===== items on the coffee table (near edge is x = 0.95) ===== -->
    <body name="mug" pos="1.08 0.22 0.40">
      <freejoint name="mug_free"/>
      <geom name="mug_body" class="item" type="cylinder" pos="0 0 0.05" size="0.04 0.05"
            material="mug" mass="0.22"/>
      <geom name="mug_handle" class="item" type="box" pos="0 0.05 0.05" size="0.008 0.012 0.03"
            material="mug" mass="0.03"/>
      <geom class="look" mesh="look_mug" material="look_mug"/>
    </body>

    <body name="can" pos="1.06 -0.05 0.40">
      <freejoint name="can_free"/>
      <geom name="can_body" class="item" type="cylinder" pos="0 0 0.06" size="0.033 0.06"
            material="can" mass="0.15"/>
      <geom class="look" mesh="look_can" material="look_can"/>
    </body>

    <body name="remote" pos="1.07 -0.28 0.40" euler="0 0 0.6">
      <freejoint name="remote_free"/>
      <geom name="remote_body" class="item" type="box" pos="0 0 0.0125" size="0.09 0.024 0.0125"
            material="remote" mass="0.12"/>
      <geom class="look" mesh="look_remote" material="look_remote"/>
    </body>

    <!-- ===== items on the side table ===== -->
    <body name="bottle" pos="0 1.22 0.60">
      <freejoint name="bottle_free"/>
      <geom name="bottle_body" class="item" type="cylinder" pos="0 0 0.09" size="0.035 0.09"
            material="bottle" mass="0.20"/>
      <geom name="bottle_neck" class="item" type="cylinder" pos="0 0 0.20" size="0.016 0.02"
            material="bottle" mass="0.02"/>
      <geom class="look" mesh="look_bottle" material="look_bottle"/>
    </body>

    <!-- ===== "missing" items on the floor ===== -->
    <body name="keys" pos="-0.9 0.5 0" euler="0 0 -0.4">
      <freejoint name="keys_free"/>
      <geom name="keys_body" class="item" type="box" pos="0 0 0.012" size="0.035 0.018 0.012"
            material="keys" mass="0.06"/>
      <geom name="keys_ring" class="item" type="cylinder" pos="0.05 0 0.004" size="0.015 0.004"
            material="keys" mass="0.01"/>
      <geom class="look" mesh="look_keys_metal" material="look_keys_metal"/>
      <geom class="look" mesh="look_keys_fob" material="look_keys_fob"/>
    </body>

    <body name="ball" pos="-0.9 -0.4 0">
      <freejoint name="ball_free"/>
      <geom name="ball_body" class="item" type="sphere" pos="0 0 0.035" size="0.035"
            material="ball" mass="0.06" condim="6" friction="1.0 0.02 0.002"/>
      <geom class="look" mesh="look_ball" material="look_ball"/>
    </body>

    <body name="box" pos="-0.6 -0.9 0" euler="0 0 0.3">
      <freejoint name="box_free"/>
      <geom name="box_body" class="item" type="box" pos="0 0 0.025" size="0.06 0.025 0.025"
            material="box" mass="0.10"/>
      <geom class="look" mesh="look_box" material="look_box"/>
    </body>
  </worldbody>
</mujoco>
