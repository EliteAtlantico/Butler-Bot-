<mujoco model="bracketbot home">
  <include file="../../main_mujoco/chopped_dynamic.xml"/>
  <!-- chopped_dynamic.xml sets meshdir relative to main_mujoco; point it back
       there from this folder. Must come after the include to take effect. -->
  <compiler meshdir="../../main_mujoco/meshes/"/>

  <statistic center="0.8 0 0.5" extent="2.6"/>

  <visual>
    <headlight diffuse="0.55 0.55 0.55" ambient="0.35 0.35 0.35" specular="0.1 0.1 0.1"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="150" elevation="-20" offwidth="1280" offheight="960"/>
    <map znear="0.005" zfar="30"/>
    <quality shadowsize="4096"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="woodfloor" builtin="checker" mark="edge" rgb1="0.55 0.45 0.35"
             rgb2="0.5 0.4 0.3" markrgb="0.4 0.32 0.25" width="300" height="300"/>
    <material name="woodfloor" texture="woodfloor" texuniform="true" texrepeat="6 6" reflectance="0.05"/>
    <material name="furniture" rgba="0.42 0.30 0.22 1"/>
    <material name="basket" rgba="0.75 0.68 0.52 1"/>
    <material name="mug" rgba="0.85 0.18 0.18 1"/>
    <material name="can" rgba="0.15 0.70 0.25 1"/>
    <material name="bottle" rgba="0.92 0.80 0.10 1"/>
    <material name="remote" rgba="0.50 0.20 0.75 1"/>
    <material name="keys" rgba="0.95 0.50 0.10 1"/>
    <material name="ball" rgba="0.95 0.30 0.65 1"/>
    <material name="box" rgba="0.10 0.65 0.70 1"/>
  </asset>

  <!-- Household objects. Every pickable object is a free body whose name
       matches a class in Hand_and_Wrists/handwrist/objects.py. Sizes are read
       back out of the compiled model, so changing a geom here is enough.
       Objects have lower contact priority than the finger pads, so the pads'
       friction governs the grasp. -->
  <default>
    <default class="item">
      <geom condim="4" friction="1.0 0.01 0.001" solref="0.005 1" priority="1"/>
    </default>
  </default>

  <worldbody>
    <light pos="1 0 4" dir="0 0 -1" directional="true" diffuse="0.5 0.5 0.5"/>
    <light pos="3 3 3" dir="-1 -1 -1" diffuse="0.35 0.35 0.35"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="woodfloor"
          friction="1.6 0.01 0.001" condim="4"/>

    <!-- coffee table, 0.40 m high, in front of the robot's start pose -->
    <body name="coffee_table" pos="1.25 0 0">
      <geom name="coffee_table_top" type="box" pos="0 0 0.385" size="0.30 0.45 0.015"
            material="furniture" friction="1.0 0.01 0.001" condim="4"/>
      <geom type="box" pos=" 0.26  0.41 0.185" size="0.025 0.025 0.185" material="furniture"/>
      <geom type="box" pos=" 0.26 -0.41 0.185" size="0.025 0.025 0.185" material="furniture"/>
      <geom type="box" pos="-0.26  0.41 0.185" size="0.025 0.025 0.185" material="furniture"/>
      <geom type="box" pos="-0.26 -0.41 0.185" size="0.025 0.025 0.185" material="furniture"/>
    </body>

    <!-- side table, 0.60 m high, to the robot's left -->
    <body name="side_table" pos="0 1.4 0">
      <geom name="side_table_top" type="box" pos="0 0 0.585" size="0.22 0.22 0.015"
            material="furniture" friction="1.0 0.01 0.001" condim="4"/>
      <geom type="box" pos="0 0 0.285" size="0.03 0.03 0.285" material="furniture"/>
      <geom type="box" pos="0 0 0.01" size="0.18 0.18 0.01" material="furniture"/>
    </body>

    <!-- laundry basket on the floor, to the robot's right: the drop-off -->
    <body name="basket" pos="0.2 -1.3 0">
      <geom type="box" pos="0 0 0.005" size="0.2 0.15 0.005" material="basket"/>
      <geom type="box" pos=" 0.195 0 0.09" size="0.005 0.15 0.09" material="basket"/>
      <geom type="box" pos="-0.195 0 0.09" size="0.005 0.15 0.09" material="basket"/>
      <geom type="box" pos="0  0.145 0.09" size="0.2 0.005 0.09" material="basket"/>
      <geom type="box" pos="0 -0.145 0.09" size="0.2 0.005 0.09" material="basket"/>
    </body>

    <!-- ===== items on the coffee table (near edge is x = 0.95) ===== -->
    <body name="mug" pos="1.08 0.22 0.40">
      <freejoint name="mug_free"/>
      <geom name="mug_body" class="item" type="cylinder" pos="0 0 0.05" size="0.04 0.05"
            material="mug" mass="0.22"/>
      <geom name="mug_handle" class="item" type="box" pos="0 0.05 0.05" size="0.008 0.012 0.03"
            material="mug" mass="0.03"/>
    </body>

    <body name="can" pos="1.06 -0.05 0.40">
      <freejoint name="can_free"/>
      <geom name="can_body" class="item" type="cylinder" pos="0 0 0.06" size="0.033 0.06"
            material="can" mass="0.15"/>
    </body>

    <body name="remote" pos="1.07 -0.28 0.40" euler="0 0 0.6">
      <freejoint name="remote_free"/>
      <geom name="remote_body" class="item" type="box" pos="0 0 0.0125" size="0.09 0.024 0.0125"
            material="remote" mass="0.12"/>
    </body>

    <!-- ===== items on the side table ===== -->
    <body name="bottle" pos="0 1.22 0.60">
      <freejoint name="bottle_free"/>
      <geom name="bottle_body" class="item" type="cylinder" pos="0 0 0.09" size="0.035 0.09"
            material="bottle" mass="0.20"/>
      <geom name="bottle_neck" class="item" type="cylinder" pos="0 0 0.20" size="0.016 0.02"
            material="bottle" mass="0.02"/>
    </body>

    <!-- ===== "missing" items on the floor ===== -->
    <body name="keys" pos="-0.9 0.5 0" euler="0 0 -0.4">
      <freejoint name="keys_free"/>
      <geom name="keys_body" class="item" type="box" pos="0 0 0.012" size="0.035 0.018 0.012"
            material="keys" mass="0.06"/>
      <geom name="keys_ring" class="item" type="cylinder" pos="0.05 0 0.004" size="0.015 0.004"
            material="keys" mass="0.01"/>
    </body>

    <body name="ball" pos="-0.9 -0.4 0">
      <freejoint name="ball_free"/>
      <geom name="ball_body" class="item" type="sphere" pos="0 0 0.035" size="0.035"
            material="ball" mass="0.06" condim="6" friction="1.0 0.02 0.002"/>
    </body>

    <body name="box" pos="-0.6 -0.9 0" euler="0 0 0.3">
      <freejoint name="box_free"/>
      <geom name="box_body" class="item" type="box" pos="0 0 0.025" size="0.06 0.025 0.025"
            material="box" mass="0.10"/>
    </body>
  </worldbody>
</mujoco>
